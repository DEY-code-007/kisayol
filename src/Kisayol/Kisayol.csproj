<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kisayol</AssemblyName>
    <RootNamespace>Kisayol</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Kısayol</Product>
    <Company>Deniz Egemen Yılmaz</Company>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
  </ItemGroup>
  <ItemGroup>
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
